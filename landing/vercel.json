{
  "rewrites": [
    { "source": "/whitepaper.md", "destination": "/whitepaper.md" },
    { "source": "/(.*)", "destination": "/index.html" }
  ],
  "headers": [
    {
      "source": "/whitepaper.md",
      "headers": [
        { "key": "Content-Type", "value": "text/plain; charset=utf-8" }
      ]
    }
  ]
}
