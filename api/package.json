{
  "name": "@emet-protocol/api",
  "version": "0.4.0",
  "description": "REST API server for the EMET Protocol with SQLite persistence",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "node server.js",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage"
  },
  "dependencies": {
    "better-sqlite3": "^11.0.0",
    "cors": "^2.8.5",
    "express": "^4.21.0"
  },
  "devDependencies": {
    "jest": "^29.7.0",
    "supertest": "^7.0.0"
  },
  "jest": {
    "testEnvironment": "node",
    "coverageDirectory": "coverage",
    "collectCoverageFrom": [
      "*.js",
      "db/*.js",
      "!server.js"
    ],
    "testPathIgnorePatterns": [
      "/node_modules/"
    ]
  }
}
